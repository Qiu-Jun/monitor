{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2018",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2018", "DOM"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "importHelpers": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
