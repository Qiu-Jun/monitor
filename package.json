{
  "name": "@qiu_jun/monitors",
  "version": "0.0.3",
  "description": "前端监控，用于捕获，分析，和报告网站或应用程序中的异常，错误和性能问题的方法",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/monitor.umd.js",
      "default": "./dist/index.js"
    },
    "./h5": {
      "types": "./dist/h5.d.ts",
      "default": "./dist/h5.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm run clean && pnpm run compile && pnpm run bundle",
    "clean": "rimraf dist",
    "compile": "tsc -p tsconfig.build.json",
    "bundle": "vite build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qiu-Jun/monitor.git"
  },
  "author": "June",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Qiu-Jun/monitor/issues"
  },
  "homepage": "https://github.com/Qiu-Jun/monitor#readme",
  "devDependencies": {
    "rimraf": "^6.0.1",
    "terser": "^5.43.1",
    "typescript": "~6.0.3",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "ua-parser-js": "^2.0.4"
  }
}
